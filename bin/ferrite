#!/usr/bin/env bash
# ==============================================================================
# Ferrite Telemetry Engine Daemon Launcher
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${ROOT_DIR}"
exec ./gradlew run --args="$*"
