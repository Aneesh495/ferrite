#!/usr/bin/env bash
# ==============================================================================
# Ferrite Telemetry Engine Benchmark Runner
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${ROOT_DIR}"
echo "Running Compression Benchmark..."
./gradlew -q --console=plain executeCompressionBenchmark
echo ""
echo "Running Ingestion Benchmark..."
./gradlew -q --console=plain executeIngestionBenchmark
