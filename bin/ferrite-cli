#!/usr/bin/env bash
# ==============================================================================
# Ferrite Interactive REPL Launcher
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${ROOT_DIR}"
exec ./gradlew -q --console=plain run --args="--cli $*"
